#include <iostream>
#include <iomanip>
#include <cmath>
#include <chrono>
#include <thread>

int main() {     //Объявление главной функции
	double a, b, h;
	double epsilon = 1e-9;
	std::this_thread::sleep_for(std::chrono::seconds(2));      //Создание задержки 
	std::cout << "Enter the start of interval a: ";
	std::cin >> a;
	std::this_thread::sleep_for(std::chrono::seconds(2));
	std::cout << "Enter the end of interval b: ";
	std::cin >> b;
	std::this_thread::sleep_for(std::chrono::seconds(2));
	std::cout << "Enter the step h: ";
	std::cin >> h;
	if (a > b) {      	//Написание условия	
		std::this_thread::sleep_for(std::chrono::seconds(2));
		std::cout << "Error: start cannot be bigger than end!" << std::endl;
		return 1;
	}
	if (h <= 0) {
		std::this_thread::sleep_for(std::chrono::seconds(2));
		std::cout << "Error: step must be positive!" << std::endl;
		return 1;
	}
	std::this_thread::sleep_for(std::chrono::seconds(2));
	std::cout << "\n============================================" << std::endl;
	std::this_thread::sleep_for(std::chrono::seconds(2));
	std::cout << "  x     |      y=arctg(x)   " << std::endl;
	std::this_thread::sleep_for(std::chrono::seconds(2));
	std::cout << "============================================" << std::endl;
	std::cout << std::fixed << std::setprecision(4);
	for (double x = a; x <= b + 1e-9; x += h) {      //Цикл для заданных величин
		double y = atan(x);
		std::this_thread::sleep_for(std::chrono::seconds(2));
		std::cout << std::setw(8) << x << "|" << std::setw(12) << y << std::endl;
		if (std::abs(y) < epsilon) {
			std::this_thread::sleep_for(std::chrono::seconds(2));
			std::cout << "The nearest to zero is " << y << std::endl;
			return 0;
		}
	}
	std::this_thread::sleep_for(std::chrono::seconds(2));
	std::cout << "============================================" << std::endl;
	return 0;      //Успешное завершение алгоритма
}
