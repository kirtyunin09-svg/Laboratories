#include <iostream>
#include <vector>
#include <random>

int main() {     //Объявление главной функции
    const int n = 100; //Размер массива
    std::vector<int> arr(n);

    std::mt19937 gen(std::random_device{}());
    std::uniform_int_distribution<> dist(10, 99);

    for (int i = 0; i < n; ++i) {    //Написание цикла
        arr[i] = dist(gen);
    }

    int count = 0;
    for (int x : arr) {
        if (x < 30) ++count;
    }

    std::cout << count << std::endl;
    return 0;
}
