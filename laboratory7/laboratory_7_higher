#include <iostream>
#include <iomanip>
#include <cstdlib>
#include <ctime>

using namespace std;

int main() {
  setlocale(LC_ALL, "Russian");
  srand(time(0));
  const int ROWS = 5;
  const int COLS = 5;
  const int NEW_COLS = COLS + 1;
  int matrix[ROWS][NEW_COLS];
  std::cout << "Исходная матрица 5х5:" << std::endl;
  for (int i = 0; i < ROWS; i++) {
    for (int j = 0; j < COLS; j++) {
      matrix[i][j] = rand() % 100 + 1;
      std::cout << setw(4) << matrix[i][j] << " ";
    }
    std::cout << std::endl;
  }
  std::cout << "\nВведите " << ROWS << " значений для нового столбца:\n";
  for (int i = 0; i < ROWS; i++) {
    int value;
    std::cout << "Значение для строки " << i + 1 << ": ";
    std::cin >> value;
    matrix[i][COLS] = value;
  }
  std::cout << "\nИтоговая матрица (5х6):" << std::endl;
  for (int i = 0; i < ROWS; i++) {
    for (int j = 0; j < NEW_COLS; j++) {
      std::cout << setw(4) << matrix[i][j] << " ";
    }
    std::cout << std::endl;
  }
  return 0;
}
