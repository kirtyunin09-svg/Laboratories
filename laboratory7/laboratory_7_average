#include <iostream>
#include <iomanip>
#include <cstdlib>
#include <ctime>

int main() {
  const int N = 5;
  int matrix[N][N];
  std::srand(static_cast<unsigned>(std::time(nullptr)));
  for (int i = 0; i < N; i++) {
    for (int j = 0; j < N; j++) {
      matrix[i][j] = 0 + std::rand() % 100;
    }
  }
  std::cout << "Matrix " << N << "x" << N << ":" << std::endl;
  for (int i = 0; i < N; i++) {
    for (int j = 0; j < N; j++) {
      std::cout << std::setw(4) << matrix[i][j];
    }
    std::cout << std::endl;
  }
  std::cout << std::endl;
  std::cout << "Main diagonal: ";
  for (int i = 0; i < N; i++) {
    std::cout << matrix[i][i] << " ";
  }
  std::cout << std::endl;
  int sumMain = 0;
  for (int i = 0; i < N; i++) {
    sumMain += matrix[i][i];
  }
  std::cout << "Main diagonal sum: " << sumMain << std::endl;
  std::cout << "Second diagonal: ";
  for (int i = 0; i < N; i++) {
    std::cout << matrix[i][N - 1 - i] << " ";
  }
  std::cout << std::endl;
  int sumSecondary = 0;
  for (int i = 0; i < N; i++) {
    sumSecondary += matrix[i][N - 1 - i];
  }
  std::cout << "Second diagonal sum: " << sumSecondary << std::endl;
  double srednee = (static_cast<double>(sumMain) + sumSecondary) / 10;
  std::cout << "The average is " << srednee << std::endl;
  return 0;
}
