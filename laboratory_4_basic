#include <iostream>

int main() {
	int command;
	std::cin >> command;
	switch (command) {
	case 1:
		std::cout << "Start" << std::endl;
		break;
	case 2:
		std::cout << "Pause" << std::endl;
		break;
	case 3:
		std::cout << "Stop" << std::endl;
		break;
	default:
		std::cout << "Undefined command" << std::endl;
		break;
	}
	return 0;
}
